rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             'email_verified' in request.auth.token &&
             request.auth.token.email == 'abhixfactor@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isBootstrappedAdmin()
      );
    }

    function isAdminForTrade(tradeId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.assignedTradeId == tradeId) ||
        isBootstrappedAdmin()
      );
    }

    function isTraineeOwner(traineeId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/trainees/$(traineeId)) &&
             get(/databases/$(database)/documents/trainees/$(traineeId)).data.traineeUid == request.auth.uid;
    }

    // 1. Validation Helper: AdminProfile
    function isValidAdminProfile(data) {
      return data.keys().hasAll([
               'adminId', 'fullName', 'assignedTradeId', 'assignedTradeName',
               'sessionYear', 'officerVerificationCode', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'adminId', 'fullName', 'assignedTradeId', 'assignedTradeName',
               'sessionYear', 'officerVerificationCode', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.adminId) &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             isValidId(data.assignedTradeId) &&
             data.assignedTradeName is string && data.assignedTradeName.size() >= 2 && data.assignedTradeName.size() <= 100 &&
             data.sessionYear is string && data.sessionYear.size() >= 4 && data.sessionYear.size() <= 20 &&
             data.officerVerificationCode is string && data.officerVerificationCode == 'ITI-RAIGARH-OFFICER' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(adminId) &&
                       request.auth.uid == adminId &&
                       incoming().adminId == request.auth.uid &&
                       isValidAdminProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(adminId) &&
                       isValidAdminProfile(incoming()) &&
                       request.auth.uid == adminId &&
                       incoming().adminId == existing().adminId &&
                       incoming().officerVerificationCode == existing().officerVerificationCode &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'fullName', 'assignedTradeId', 'assignedTradeName', 'sessionYear', 'updatedAt'
                       ]);

      allow delete: if false;
    }

    // 2. Validation Helper: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll([
               'userId', 'fullName', 'registrationNumber', 'role',
               'tradeId', 'tradeName', 'sessionYear', 'isActive', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'fullName', 'registrationNumber', 'role',
               'tradeId', 'tradeName', 'sessionYear', 'isActive', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.userId) &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.registrationNumber is string && data.registrationNumber.size() >= 2 && data.registrationNumber.size() <= 50 &&
             data.role is string && data.role in ['ADMIN', 'TRAINEE'] &&
             isValidId(data.tradeId) &&
             data.tradeName is string && data.tradeName.size() >= 2 && data.tradeName.size() <= 100 &&
             data.sessionYear is string && data.sessionYear.size() >= 4 && data.sessionYear.size() <= 20 &&
             data.isActive is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      // Prevent self-assigned ADMIN role unless verified in /admins/{uid}
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       isValidUserProfile(incoming()) &&
                       (incoming().role == 'TRAINEE' || isAdmin());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Standard profile update without changing role
                         (incoming().role == existing().role &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'fullName', 'registrationNumber', 'tradeId', 'tradeName',
                            'sessionYear', 'isActive', 'updatedAt'
                          ])) ||
                         // Action 2: Verified Admin updating profile or role mode
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'fullName', 'registrationNumber', 'role', 'tradeId', 'tradeName',
                            'sessionYear', 'isActive', 'updatedAt'
                          ]))
                       );

      allow delete: if false;
    }

    // 3. Validation Helper: Trade
    function isValidTrade(data) {
      return data.keys().hasAll([
               'tradeId', 'tradeName', 'tradeCode', 'adminId', 'adminName',
               'sessionYear', 'totalWorkingDays', 'maxCasualLeave', 'maxMedicalLeave',
               'halfDayDeductionRule', 'maxHalfDayLeaves', 'minAttendancePercent',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'tradeId', 'tradeName', 'tradeCode', 'adminId', 'adminName',
               'sessionYear', 'totalWorkingDays', 'maxCasualLeave', 'maxMedicalLeave',
               'halfDayDeductionRule', 'maxHalfDayLeaves', 'minAttendancePercent',
               'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.tradeId) &&
             data.tradeName is string && data.tradeName.size() >= 2 && data.tradeName.size() <= 100 &&
             data.tradeCode is string && data.tradeCode.size() >= 2 && data.tradeCode.size() <= 30 &&
             isValidId(data.adminId) &&
             data.adminName is string && data.adminName.size() >= 2 && data.adminName.size() <= 100 &&
             data.sessionYear is string && data.sessionYear.size() >= 4 && data.sessionYear.size() <= 20 &&
             data.totalWorkingDays is int && data.totalWorkingDays >= 1 && data.totalWorkingDays <= 366 &&
             data.maxCasualLeave is int && data.maxCasualLeave >= 1 && data.maxCasualLeave <= 12 &&
             data.maxMedicalLeave is int && data.maxMedicalLeave >= 1 && data.maxMedicalLeave <= 36 &&
             data.halfDayDeductionRule is string && data.halfDayDeductionRule in ['DEDUCT_HALF_CL', 'SEPARATE_QUOTA'] &&
             data.maxHalfDayLeaves is int && data.maxHalfDayLeaves >= 1 && data.maxHalfDayLeaves <= 24 &&
             data.minAttendancePercent is int && data.minAttendancePercent >= 1 && data.minAttendancePercent <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /trades/{tradeId} {
      allow get: if isSignedIn() &&
                    isValidId(tradeId) && (
                      existing().adminId == request.auth.uid ||
                      isAdminForTrade(tradeId) ||
                      (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tradeId == tradeId)
                    );

      allow list: if isSignedIn() && existing().adminId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(tradeId) &&
                       isValidTrade(incoming()) &&
                       incoming().tradeId == tradeId &&
                       incoming().adminId == request.auth.uid &&
                       isAdminForTrade(tradeId);

      allow update: if isSignedIn() &&
                       isValidId(tradeId) &&
                       isValidTrade(incoming()) &&
                       existing().adminId == request.auth.uid &&
                       incoming().tradeId == existing().tradeId &&
                       incoming().adminId == existing().adminId &&
                       incoming().createdAt == existing().createdAt &&
                       isAdminForTrade(tradeId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'tradeName', 'tradeCode', 'adminName', 'sessionYear',
                         'totalWorkingDays', 'maxCasualLeave', 'maxMedicalLeave',
                         'halfDayDeductionRule', 'maxHalfDayLeaves', 'minAttendancePercent', 'updatedAt'
                       ]);

      allow delete: if false;
    }

    // 4. Validation Helper: TraineeRecord
    function isValidTraineeRecord(data) {
      return data.keys().hasAll([
               'traineeId', 'traineeUid', 'adminId', 'tradeId', 'tradeName',
               'sessionYear', 'fullName', 'registrationNumber', 'fatherName',
               'batchShift', 'isActive', 'presentDays', 'absentDays', 'halfDays',
               'approvedLeaveDays', 'casualLeaveUsed', 'medicalLeaveUsed',
               'halfDayLeaveUsed', 'lowAttendanceWarningCount', 'lastWarningMessage',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'traineeId', 'traineeUid', 'adminId', 'tradeId', 'tradeName',
               'sessionYear', 'fullName', 'registrationNumber', 'fatherName',
               'batchShift', 'isActive', 'presentDays', 'absentDays', 'halfDays',
               'approvedLeaveDays', 'casualLeaveUsed', 'medicalLeaveUsed',
               'halfDayLeaveUsed', 'lowAttendanceWarningCount', 'lastWarningMessage',
               'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.traineeId) &&
             isValidId(data.traineeUid) &&
             isValidId(data.adminId) &&
             isValidId(data.tradeId) &&
             data.tradeName is string && data.tradeName.size() >= 2 && data.tradeName.size() <= 100 &&
             data.sessionYear is string && data.sessionYear.size() >= 4 && data.sessionYear.size() <= 20 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.registrationNumber is string && data.registrationNumber.size() >= 2 && data.registrationNumber.size() <= 50 &&
             data.fatherName is string && data.fatherName.size() >= 2 && data.fatherName.size() <= 100 &&
             data.batchShift is string && data.batchShift.size() >= 2 && data.batchShift.size() <= 50 &&
             data.isActive is bool &&
             data.presentDays is int && data.presentDays >= 0 && data.presentDays <= 366 &&
             data.absentDays is int && data.absentDays >= 0 && data.absentDays <= 366 &&
             data.halfDays is int && data.halfDays >= 0 && data.halfDays <= 366 &&
             data.approvedLeaveDays is int && data.approvedLeaveDays >= 0 && data.approvedLeaveDays <= 366 &&
             data.casualLeaveUsed is int && data.casualLeaveUsed >= 0 && data.casualLeaveUsed <= 12 &&
             data.medicalLeaveUsed is int && data.medicalLeaveUsed >= 0 && data.medicalLeaveUsed <= 36 &&
             data.halfDayLeaveUsed is int && data.halfDayLeaveUsed >= 0 && data.halfDayLeaveUsed <= 24 &&
             data.lowAttendanceWarningCount is int && data.lowAttendanceWarningCount >= 0 && data.lowAttendanceWarningCount <= 100 &&
             data.lastWarningMessage is string && data.lastWarningMessage.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /trainees/{traineeId} {
      allow get: if isSignedIn() &&
                    isValidId(traineeId) && (
                      existing().traineeUid == request.auth.uid ||
                      (existing().adminId == request.auth.uid && isAdminForTrade(existing().tradeId))
                    );

      allow list: if isSignedIn() && (
                     existing().traineeUid == request.auth.uid ||
                     existing().adminId == request.auth.uid
                   );

      allow create: if isSignedIn() &&
                       isValidId(traineeId) &&
                       isValidTraineeRecord(incoming()) &&
                       incoming().traineeId == traineeId && (
                         // Admin creating a trainee in their assigned Trade
                         (incoming().adminId == request.auth.uid &&
                          isAdminForTrade(incoming().tradeId) &&
                          exists(/databases/$(database)/documents/trades/$(incoming().tradeId))) ||
                         // Trainee initializing their own trainee record after creating UserProfile
                         (incoming().traineeUid == request.auth.uid &&
                          incoming().traineeId == request.auth.uid &&
                          exists(/databases/$(database)/documents/users/$(request.auth.uid)))
                       );

      allow update: if isSignedIn() &&
                       isValidId(traineeId) &&
                       isValidTraineeRecord(incoming()) &&
                       incoming().traineeId == existing().traineeId &&
                       incoming().tradeId == existing().tradeId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Assigned Trade Admin updating trainee details, counters, or warnings
                         (existing().adminId == request.auth.uid &&
                          isAdminForTrade(existing().tradeId) &&
                          incoming().adminId == existing().adminId &&
                          incoming().traineeUid == existing().traineeUid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'fullName', 'registrationNumber', 'fatherName', 'batchShift',
                            'sessionYear', 'isActive', 'presentDays', 'absentDays', 'halfDays',
                            'approvedLeaveDays', 'casualLeaveUsed', 'medicalLeaveUsed',
                            'halfDayLeaveUsed', 'lowAttendanceWarningCount', 'lastWarningMessage',
                            'updatedAt'
                          ])) ||
                         // Action 2: Active Trainee updating their own attendance count upon marking attendance
                         (existing().traineeUid == request.auth.uid &&
                          existing().isActive == true &&
                          incoming().adminId == existing().adminId &&
                          incoming().traineeUid == existing().traineeUid &&
                          incoming().isActive == existing().isActive &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'presentDays', 'absentDays', 'halfDays', 'updatedAt'
                          ]))
                       );

      allow delete: if false;
    }

    // 5. Validation Helper: AttendanceRecord
    function isValidAttendanceRecord(data) {
      return data.keys().hasAll([
               'attendanceId', 'traineeId', 'traineeUid', 'traineeName',
               'registrationNumber', 'tradeId', 'tradeName', 'adminId',
               'dateString', 'monthString', 'sessionYear', 'status',
               'markedByRole', 'remarks', 'checkInTime', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'attendanceId', 'traineeId', 'traineeUid', 'traineeName',
               'registrationNumber', 'tradeId', 'tradeName', 'adminId',
               'dateString', 'monthString', 'sessionYear', 'status',
               'markedByRole', 'remarks', 'checkInTime', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.attendanceId) &&
             isValidId(data.traineeId) &&
             isValidId(data.traineeUid) &&
             data.traineeName is string && data.traineeName.size() >= 2 && data.traineeName.size() <= 100 &&
             data.registrationNumber is string && data.registrationNumber.size() >= 2 && data.registrationNumber.size() <= 50 &&
             isValidId(data.tradeId) &&
             data.tradeName is string && data.tradeName.size() >= 2 && data.tradeName.size() <= 100 &&
             isValidId(data.adminId) &&
             data.dateString is string && data.dateString.size() == 10 && data.dateString.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.monthString is string && data.monthString.size() == 7 && data.monthString.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.sessionYear is string && data.sessionYear.size() >= 4 && data.sessionYear.size() <= 20 &&
             data.status is string && data.status in ['PRESENT', 'ABSENT', 'ON_LEAVE', 'HALF_DAY'] &&
             data.markedByRole is string && data.markedByRole in ['TRAINEE', 'ADMIN'] &&
             data.remarks is string && data.remarks.size() <= 200 &&
             data.checkInTime is string && data.checkInTime.size() >= 1 && data.checkInTime.size() <= 20 &&
             data.attendanceId == data.traineeId + '_' + data.dateString &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /attendance/{attendanceId} {
      allow get: if isSignedIn() &&
                    isValidId(attendanceId) && (
                      existing().traineeUid == request.auth.uid ||
                      (existing().adminId == request.auth.uid && isAdminForTrade(existing().tradeId))
                    );

      allow list: if isSignedIn() && (
                     existing().traineeUid == request.auth.uid ||
                     existing().adminId == request.auth.uid
                   );

      // Enforces 1 record per trainee per day via deterministic ID: traineeId + '_' + dateString
      allow create: if isSignedIn() &&
                       isValidId(attendanceId) &&
                       isValidAttendanceRecord(incoming()) &&
                       incoming().attendanceId == attendanceId && (
                         (incoming().traineeUid == request.auth.uid &&
                          incoming().markedByRole == 'TRAINEE' &&
                          incoming().status in ['PRESENT', 'HALF_DAY'] &&
                          isTraineeOwner(incoming().traineeId)) ||
                         (incoming().adminId == request.auth.uid &&
                          incoming().markedByRole == 'ADMIN' &&
                          isAdminForTrade(incoming().tradeId) &&
                          exists(/databases/$(database)/documents/trainees/$(incoming().traineeId)))
                       );

      // Only the Trade's Training Officer can update an attendance record (e.g., on leave approval or correction)
      allow update: if isSignedIn() &&
                       isValidId(attendanceId) &&
                       isValidAttendanceRecord(incoming()) &&
                       existing().adminId == request.auth.uid &&
                       isAdminForTrade(existing().tradeId) &&
                       incoming().attendanceId == existing().attendanceId &&
                       incoming().traineeId == existing().traineeId &&
                       incoming().traineeUid == existing().traineeUid &&
                       incoming().tradeId == existing().tradeId &&
                       incoming().adminId == existing().adminId &&
                       incoming().dateString == existing().dateString &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'markedByRole', 'remarks', 'checkInTime', 'updatedAt'
                       ]);

      allow delete: if false;
    }

    // 6. Validation Helper: LeaveApplication
    function isValidLeaveApplication(data) {
      return data.keys().hasAll([
               'leaveId', 'traineeId', 'traineeUid', 'traineeName',
               'registrationNumber', 'tradeId', 'tradeName', 'adminId',
               'sessionYear', 'leaveType', 'startDate', 'endDate', 'monthString',
               'totalDays', 'halfDaySession', 'reason', 'status',
               'adminRemarks', 'reviewedBy', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'leaveId', 'traineeId', 'traineeUid', 'traineeName',
               'registrationNumber', 'tradeId', 'tradeName', 'adminId',
               'sessionYear', 'leaveType', 'startDate', 'endDate', 'monthString',
               'totalDays', 'halfDaySession', 'reason', 'status',
               'adminRemarks', 'reviewedBy', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.leaveId) &&
             isValidId(data.traineeId) &&
             isValidId(data.traineeUid) &&
             data.traineeName is string && data.traineeName.size() >= 2 && data.traineeName.size() <= 100 &&
             data.registrationNumber is string && data.registrationNumber.size() >= 2 && data.registrationNumber.size() <= 50 &&
             isValidId(data.tradeId) &&
             data.tradeName is string && data.tradeName.size() >= 2 && data.tradeName.size() <= 100 &&
             isValidId(data.adminId) &&
             data.sessionYear is string && data.sessionYear.size() >= 4 && data.sessionYear.size() <= 20 &&
             data.leaveType is string && data.leaveType in ['CL', 'HALF_DAY', 'MEDICAL'] &&
             data.startDate is string && data.startDate.size() == 10 && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.endDate is string && data.endDate.size() == 10 && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.monthString is string && data.monthString.size() == 7 && data.monthString.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.totalDays is int && data.totalDays >= 1 && (
               (data.leaveType == 'CL' && data.totalDays <= 12 && data.halfDaySession == 'NONE') ||
               (data.leaveType == 'HALF_DAY' && data.totalDays == 1 && data.halfDaySession in ['FIRST_HALF', 'SECOND_HALF']) ||
               (data.leaveType == 'MEDICAL' && data.totalDays <= 36 && data.halfDaySession == 'NONE')
             ) &&
             data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 300 &&
             data.status is string && data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.adminRemarks is string && data.adminRemarks.size() <= 300 &&
             data.reviewedBy is string && data.reviewedBy.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /leaves/{leaveId} {
      allow get: if isSignedIn() &&
                    isValidId(leaveId) && (
                      existing().traineeUid == request.auth.uid ||
                      (existing().adminId == request.auth.uid && isAdminForTrade(existing().tradeId))
                    );

      allow list: if isSignedIn() && (
                     existing().traineeUid == request.auth.uid ||
                     existing().adminId == request.auth.uid
                   );

      allow create: if isSignedIn() &&
                       isValidId(leaveId) &&
                       isValidLeaveApplication(incoming()) &&
                       incoming().leaveId == leaveId &&
                       incoming().status == 'PENDING' && (
                         (incoming().traineeUid == request.auth.uid &&
                          isTraineeOwner(incoming().traineeId)) ||
                         (incoming().adminId == request.auth.uid &&
                          isAdminForTrade(incoming().tradeId) &&
                          exists(/databases/$(database)/documents/trainees/$(incoming().traineeId)))
                       );

      // Action: Admin review (Approve / Reject) with terminal state protection
      allow update: if isSignedIn() &&
                       isValidId(leaveId) &&
                       isValidLeaveApplication(incoming()) &&
                       existing().adminId == request.auth.uid &&
                       isAdminForTrade(existing().tradeId) &&
                       (existing().status == 'PENDING' || isAdmin()) &&
                       incoming().leaveId == existing().leaveId &&
                       incoming().traineeId == existing().traineeId &&
                       incoming().traineeUid == existing().traineeUid &&
                       incoming().tradeId == existing().tradeId &&
                       incoming().adminId == existing().adminId &&
                       incoming().leaveType == existing().leaveType &&
                       incoming().startDate == existing().startDate &&
                       incoming().endDate == existing().endDate &&
                       incoming().totalDays == existing().totalDays &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'adminRemarks', 'reviewedBy', 'updatedAt'
                       ]);

      allow delete: if false;
    }

    // 7. Validation Helper: TraineeNotification
    function isValidNotification(data) {
      return data.keys().hasAll([
               'notificationId', 'traineeId', 'traineeUid', 'traineeName',
               'tradeId', 'adminId', 'type', 'title', 'message',
               'isRead', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'notificationId', 'traineeId', 'traineeUid', 'traineeName',
               'tradeId', 'adminId', 'type', 'title', 'message',
               'isRead', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.notificationId) &&
             isValidId(data.traineeId) &&
             isValidId(data.traineeUid) &&
             data.traineeName is string && data.traineeName.size() >= 2 && data.traineeName.size() <= 100 &&
             isValidId(data.tradeId) &&
             isValidId(data.adminId) &&
             data.type is string && data.type in ['LEAVE_APPROVED', 'LEAVE_REJECTED', 'LOW_ATTENDANCE_WARNING', 'GENERAL_NOTICE'] &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.message is string && data.message.size() >= 2 && data.message.size() <= 400 &&
             data.isRead is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() &&
                    isValidId(notificationId) && (
                      existing().traineeUid == request.auth.uid ||
                      (existing().adminId == request.auth.uid && isAdminForTrade(existing().tradeId))
                    );

      allow list: if isSignedIn() && (
                     existing().traineeUid == request.auth.uid ||
                     existing().adminId == request.auth.uid
                   );

      allow create: if isSignedIn() &&
                       isValidId(notificationId) &&
                       isValidNotification(incoming()) &&
                       incoming().notificationId == notificationId &&
                       incoming().adminId == request.auth.uid &&
                       isAdminForTrade(incoming().tradeId) &&
                       exists(/databases/$(database)/documents/trainees/$(incoming().traineeId));

      allow update: if isSignedIn() &&
                       isValidId(notificationId) &&
                       isValidNotification(incoming()) &&
                       incoming().notificationId == existing().notificationId &&
                       incoming().traineeId == existing().traineeId &&
                       incoming().traineeUid == existing().traineeUid &&
                       incoming().tradeId == existing().tradeId &&
                       incoming().adminId == existing().adminId &&
                       incoming().type == existing().type &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Trainee marking notification as read
                         (existing().traineeUid == request.auth.uid &&
                          incoming().isRead == true &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt'])) ||
                         // Action 2: Assigned Trade Admin updating notification
                         (existing().adminId == request.auth.uid &&
                          isAdminForTrade(existing().tradeId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'isRead', 'updatedAt']))
                       );

      allow delete: if false;
    }
  }
}
